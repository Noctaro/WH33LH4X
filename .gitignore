# These were only ever in .git\info\exclude, which is local to one clone and never travels.
# A fresh clone therefore saw dist\, logs\ and .venv\ as untracked noise. This file is the
# committed version of the same list.

# --- build output ---------------------------------------------------------
dist/
shim/build/
*.obj
*.lib
*.exp
*.pdb

# --- toolchains fetched by the build --------------------------------------
tools/
zig-*-windows-*/
zig-*.zip

# --- environments and caches ----------------------------------------------
.venv/
__pycache__/
.ruff_cache/

# --- machine-specific state -----------------------------------------------
# wheel_profile.json is a calibration keyed to one wheel's VID:PID. Committing it would hand
# the next person a measurement taken on hardware they do not have.
wheel_profile.json
logs/

# --- editor and assistant ------------------------------------------------
.vscode/
.claude/
