# Build output, toolchains and caches. Anything specific to one machine stays out of here and
# lives in .git\info\exclude instead, which is local to a clone and never committed.

# --- build output ---------------------------------------------------------
dist/
*.obj
*.lib
*.exp
*.pdb

# --- toolchains fetched by the build --------------------------------------
tools/
zig-*-windows-*/
zig-*.zip

# --- environments and caches ----------------------------------------------
.venv/
__pycache__/
.ruff_cache/

# --- session output -------------------------------------------------------
# The window's own state: the selected profile and theme. One person's, not a clone's.
gui_settings.json
# The live tuning the bridge and window change; created from the tracked template tune.json.
user-tune.json
logs/
# How the window asks the bridge to stop. Both sides delete it, so one on disk means a run
# ended badly rather than that anything is wrong now.
stop.request

# --- editors --------------------------------------------------------------
.vscode/
