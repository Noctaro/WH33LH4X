<?xml version="1.0" encoding="utf-8"?>
<!--
  vJoy virtual wheel, fed by the WH33LH4X bridge (vjoy_bridge.py).

  Steering is declared here so a fresh install has working steering without going near the
  settings screen. The engine wants left and right as the two halves of ONE axis, which is
  what the lower/upper pair below says.

  This comment used to say the menu could not do it at all -- binding the second half dropped
  the device ("Steuerungsgeraet geaendert"). That was the device being unregistered, not the
  menu: with the device_defines.xml entry in place, rebinding from the game's own UI works
  (re-tested 2026-08-26).

  Axis assignment comes from vjoy_bridge.AXIS_MAP:
    di_x_axis           steering   (bidirectional, centred)
    di_y_axis           throttle   (rests low, rises when pressed)
    di_z_axis           brake
    di_x_axis_rotation  clutch
    di_y_axis_rotation  handbrake

  Pedals are type="positive" because this bridge sends them resting at minimum and rising to
  maximum. Real wheels are often wired the other way around (the G27 map uses "negative"), so
  if a pedal reads as fully pressed at rest, that word is the one to change.
-->
<action_map name="vjoy_wheel" device_name="vjoy_wheel" library="lib_direct_input">
  <group name="driving">
    <action name="accelerate">
      <axis name="di_y_axis" type="positive" deadzone="0.0" saturation="1.0" />
    </action>
    <action name="brake">
      <axis name="di_z_axis" type="positive" deadzone="0.0" saturation="1.0" />
    </action>
    <action name="clutch">
      <axis name="di_x_axis_rotation" type="positive" deadzone="0.0" saturation="1.0" />
    </action>
    <action name="handbrake">
      <axis name="di_y_axis_rotation" type="positive" deadzone="0.0" saturation="1.0" />
    </action>
    <group name="steer">
      <action name="left">
        <axis name="di_x_axis" type="lower" deadzone="0.0" saturation="1.0" />
      </action>
      <action name="right">
        <axis name="di_x_axis" type="upper" deadzone="0.0" saturation="1.0" />
      </action>
    </group>
    <group name="gear">
      <group name="sequential">
        <action name="up">
          <axis name="di_button_5" />
        </action>
        <action name="down">
          <axis name="di_button_6" />
        </action>
      </group>
    </group>
  </group>
</action_map>
